{
  "manifest_version": 3,
  "name": "Browser Vault",
  "version": "1.0.0",
  "description": "A local-first vault for reusable copy-pastables.",
  "action": {
    "default_title": "Browser Vault",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "commands": {
  "open-browser-vault": {
    "suggested_key": {
      "default": "Alt+V"
    },
    "description": "Open Browser Vault"
  }
}
}
